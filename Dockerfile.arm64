# syntax=docker/dockerfile:1
# =============================================================================
# Dockerfile.arm64 — 在任意 x86 主机上用 buildx + qemu 模拟 ARM64 环境
#                    打包 PowerRenamePy 的 Linux/aarch64 可执行文件。
#
# 用法（见 build_arm64_docker.bat）:
#   docker buildx build --platform linux/arm64 -t powerrenamepy-arm64 -f Dockerfile.arm64 .
#   然后从镜像中提取 /PowerRenamePy 即可。
#
# 原理: 官方 python:3.11-slim 镜像 + apt 安装 tcl/tk 运行时，
#       容器内运行 PyInstaller，产物就是 aarch64 原生 ELF。
# =============================================================================
FROM python:3.11-slim AS build

# tk/tcl: PyInstaller 收集 tkinter 依赖所需；slim 镜像不含 tk，必须装
RUN apt-get update \
    && apt-get install -y --no-install-recommends tk tcl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# 只拷贝运行所需的三个模块（icon.ico 由 make_icon.py 生成，Linux 打包不需要）
COPY src/main.py src/ui.py src/rename_engine.py ./

RUN python3 -m venv /venv \
    && /venv/bin/pip install --no-cache-dir pyinstaller \
    && /venv/bin/pyinstaller --onefile --name PowerRenamePy --clean --noconfirm main.py

# 只保留产物，便于用 docker create + docker cp 提取
FROM scratch AS artifact
COPY --from=build /src/dist/PowerRenamePy /PowerRenamePy
